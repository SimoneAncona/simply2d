{
  "name": "simply2d",
  "version": "1.4.0-dev.0",
  "description": "2D graphics library for node.js",
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/SimoneAncona/simply2d"
  },
  "homepage": "https://github.com/SimoneAncona/simply2d#readme",
  "type": "module",
  "scripts": {
    "build": "tsc --build && node-gyp rebuild",
    "build:dev": "tsc --build && node-gyp rebuild --debug && node tools/debug.js",
    "build:tsc": "tsc --build",
    "start": "node index.js",
    "test": "node test/animation.js && node test/test.js && node test/game.js",
    "check:win32wsl": "tsc --build && node-gyp rebuild && ubuntu run nvm use node && tsc --build && node-gyp rebuild",
    "install": "node-gyp rebuild",
    "prepare": "npm run build:tsc",
    "prepack": "npm run build:tsc && node tools/check-package.js",
    "bench": "node examples/benchmark.js"
  },
  "keywords": [
    "2d",
    "graphics",
    "graphic",
    "canvas",
    "sdl",
    "images",
    "bindings",
    "sdl2",
    "standalone",
    "standalone-application",
    "2d-games"
  ],
  "author": "Simone Ancona",
  "license": "Apache-2.0",
  "dependencies": {
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^7.0.2"
  },
  "gypfile": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "lib/*.js",
    "lib/*.d.ts",
    "binding.gyp",
    "src/",
    "include/",
    "bin/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE.txt",
    "tools/check-package.js"
  ]
}
